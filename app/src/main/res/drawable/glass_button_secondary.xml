<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Transparent fill (glass) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
        </shape>
    </item>
    <!-- Outer border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_border_outer" />
        </shape>
    </item>
    <!-- Rounded corners -->
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</layer-list>